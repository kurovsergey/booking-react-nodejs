{
  "name": "coworking-backend",
  "version": "1.0.0",
  "description": "Backend for Coworking Booking Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run db:init && ts-node-dev --respawn --transpile-only src/index.ts",
    "db:init": "echo 'Initializing DB: Running migrations & seeds...'"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "redis": "^4.6.13",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
